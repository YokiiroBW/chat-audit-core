# Application
APP_NAME=chat-audit-core
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=replace-with-a-long-random-secret
LOG_LEVEL=INFO
SYSTEM_INSTANCE_ID=chat-audit-core
ADMIN_API_TOKEN=replace-with-admin-api-token
# Optional role tokens. Legacy ADMIN_API_TOKEN remains admin.
# Roles: viewer(read-only), operator(maintenance writes), admin(destructive writes/imports).
# ADMIN_API_TOKENS=[{"name":"readonly","role":"viewer","token":"replace-with-readonly-token"}]

# Docker 宿主机挂载路径；可指向不同磁盘或 NAS 共享目录。
DATABASE_DATA_PATH=./data/database
MEDIA_STORAGE_PATH=./data/storage
BACKUP_STORAGE_PATH=./data/backups

# Database: SQLite is the default. Leave DATABASE_URL unset unless overriding it.
# Local development uses ./data/chat_audit.sqlite3; Docker Compose uses
# /app/data/database/chat_audit.sqlite3 inside the dedicated database mount.
# DATABASE_URL=sqlite+aiosqlite:///./data/chat_audit.sqlite3
# Optional PostgreSQL override, used with docker-compose.postgres.yml:
# POSTGRES_DB=chat_audit
# POSTGRES_USER=chat_audit
# POSTGRES_PASSWORD=replace-with-a-strong-password
# DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# Storage
STORAGE_ROOT=./data/storage
BACKUP_ROOT=./data/backups
PUBLIC_STORAGE_PREFIX=/static/storage

# OneBot / NapCat reverse websocket
ONEBOT_WS_PATH=/onebot/v11/ws
ONEBOT_ACCESS_TOKEN=replace-with-onebot-access-token
ONEBOT_HEARTBEAT_INTERVAL_SECONDS=30
ONEBOT_HEARTBEAT_TIMEOUT_SECONDS=10

# Media downloader
MEDIA_DOWNLOAD_TIMEOUT_SECONDS=30
MEDIA_MAX_BYTES=104857600
FFMPEG_BIN=ffmpeg
FFMPEG_LIBRARY_PATH=
MEDIA_TRANSCODE_ENABLED=false
MEDIA_TRANSCODE_VOICE_EXT=mp3
MEDIA_TRANSCODE_VIDEO_EXT=mp4
HIGH_RISK_RATE_LIMIT_PER_MINUTE=10

# Backup
AUTO_BACKUP_CRON=0 3 * * *
AUTO_BACKUP_KEEP_LATEST=7
